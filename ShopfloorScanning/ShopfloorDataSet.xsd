                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>select Stockroom, Bin, InventoryQuantity, ii.LotNumber,  case when (iltd.ShelfLifeDays + iltd.AvailabilityDays +iltd.RetestDays)&gt; 0 then lt.LotExpirationDate else LotReceiptDate end as LotReceiptDate
from _NoLock_FS_ItemInventory ii
left join _NoLock_FS_LotTrace lt on ii.LotTraceKey = lt.LotTraceKey
left join  _NoLock_FS_ItemLotTraceData iltd on ii.ItemKey = iltd.ItemKey
where 
ii.ItemKey = @ComponentItemKey and ii.InventoryCategory = 'O' 
order by 
case when (iltd.ShelfLifeDays + iltd.AvailabilityDays +iltd.RetestDays)&gt; 0 then lt.LotExpirationDate else ii.LotReceiptDate end</CommandText>
