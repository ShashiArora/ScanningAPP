          <TableAdapter BaseClass="System.ComponentModel.Component" DataAccessorModifier="AutoLayout, AnsiClass, Class, Public" DataAccessorName="ComponentListTableAdapter" GeneratorDataComponentClassName="ComponentListTableAdapter" Name="ComponentList" UserDataComponentName="ComponentListTableAdapter">
            <MainSource>
              <DbSource ConnectionRef="FourthShift (Settings)" DbObjectType="Unknown" FillMethodModifier="Public" FillMethodName="Fill" GenerateMethods="Both" GenerateShortCommands="false" GeneratorGetMethodName="GetData" GeneratorSourceName="Fill" GetMethodModifier="Public" GetMethodName="GetData" QueryType="Rowset" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="false" UserGetMethodName="GetData" UserSourceName="Fill">
                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT        
MOL.MOLineKey
, MOH.MONumber
, MOL.MOLineNumber
, I.ItemNumber
, DS.ComponentType
, MOL.ItemOrderedQuantity AS Quantity
, DS.PointOfUseID
, DS.OperationSequenceNumberString
, DSI.ItemNumber AS ComponentItemNumber
, ROUND(DS.NeededQuantity
, DSI.DecimalPrecision) AS NeededQuantity
, CASE 
WHEN LEFT(DSI.ItemNumber,5) = 'WC[C]' 
THEN '1' 
ELSE round(DS.NeededQuantity / MOL.ItemOrderedQuantity, 6) 
END AS UnitQuantity
, CASE 
WHEN LEFT(DSI.ItemNumber,5) = 'WC[C]' 
THEN isnull(@DeclaredQuantity, 0) 
ELSE round((DS.NeededQuantity / MOL.ItemOrderedQuantity) * isnull(@DeclaredQuantity, 0), DSI.DecimalPrecision) 
END AS RequiredQuantity
, DSI.DecimalPrecision
FROM            
_NoLock_FS_MOHeader AS MOH 
INNER JOIN _NoLock_FS_MOLine AS MOL ON MOL.MOHeaderKey = MOH.MOHeaderKey 
LEFT OUTER JOIN _NoLock_FS_DemandSupply AS DS ON MOL.MOLineKey = DS.TopLevelDemandSupplyKey 
LEFT OUTER JOIN _NoLock_FS_Item AS I ON MOL.ItemKey = I.ItemKey 
LEFT OUTER JOIN _NoLock_FS_Item AS DSI ON DS.DemandItemKey = DSI.ItemKey
LEFT OUTER JOIN _NoLock_FS_ItemLotTraceData AS LTD ON DS.DemandItemKey = LTD.ItemKey 
WHERE        
(MOH.MONumber = @MONumber) 
AND (MOL.MOLineNumber = @MOLineNumber) 
AND (MOL.MOLineStatus = '4') 
AND (MOL.ItemOrderedQuantity &lt;&gt; '0') 
AND (DS.OrderType = 'M') 
AND (DS.RequiredQuantity &lt;&gt; '0') 
AND (DS.ComponentType = 'R') 
AND (LTD.BackflushPolicy = 'Y')

UNION ALL

SELECT        
MOL.MOLineKey
, MOH.MONumber
, MOL.MOLineNumber
, I.ItemNumber
, 'B' AS ComponentType
, MOL.ItemOrderedQuantity AS Quantity
, MOL.PointOfUseID
, CAST(MOL.OperationSequenceNumber AS CHAR(3)) AS OperationSequenceNumberString
, I.ItemNumber AS ComponentItemNumber
, MOL.ItemOrderedQuantity
, ROUND(MOL.ItemOrderedQuantity / MOLM.ItemOrderedQuantity, 6) AS UnitQuantity
, ROUND(MOL.ItemOrderedQuantity / MOLM.ItemOrderedQuantity * ISNULL(@DeclaredQuantity, 0), I.DecimalPrecision) AS RequiredQuantity
, I.DecimalPrecision
FROM            
_NoLock_FS_MOHeader AS MOH 
INNER JOIN _NoLock_FS_MOLine AS MOL ON MOL.MOHeaderKey = MOH.MOHeaderKey 
LEFT OUTER JOIN _NoLock_FS_Item AS I ON MOL.ItemKey = I.ItemKey 
LEFT OUTER JOIN _NoLock_FS_MOLine AS MOLM ON MOH.MOHeaderKey = MOLM.MOHeaderKey AND MOLM.MOLineType = 'M'
WHERE        
(MOH.MONumber = @MONumber) 
AND (MOL.MOLineNumber = @MOLineNumber) 
AND (MOL.MOLineStatus = '4') 
AND (MOL.MOLineType = 'B') 
AND (MOL.ItemOrderedQuantity &lt;&gt; '0')
ORDER BY 
MOL.MOLineKey
, DS.PointOfUseID
, DS.OperationSequenceNumberString</CommandText>
