                    <CommandText>select ItemNumber, ItemOrderedQuantity, ReceiptQuantity, ItemOrderedQuantity - ReceiptQuantity as OpenQuantity, MOLineKey, I.PreferredStockroom, I.PreferredBin, LTD.LotNumberMask

from _NoLock_FS_MOHeader H 
  inner join _NoLock_FS_MOLine L on H.MOHeaderKey = L.MOHeaderKey
  inner join _NoLock_FS_Item I on I.ItemKey = L.ItemKey
  left join _NoLock_FS_ItemLotTraceData LTD on LTD.ItemKey = L.ItemKey

